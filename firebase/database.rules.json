{
  "rules": {
    ".read": false,
    ".write": false,
    
    "ubicaciones_tiempo_real": {
      "$choferId": {
        ".read": "auth != null",
        ".write": "auth != null && $choferId === auth.uid",
        ".validate": "newData.hasChildren(['viaje_id', 'chofer_id', 'lat', 'lng', 'timestamp'])"
      }
    },
    
    "viajes_activos": {
      "$choferId": {
        ".read": "auth != null",
        ".write": "auth != null && $choferId === auth.uid",
        ".validate": "newData.hasChildren(['viaje_id', 'ruta_id', 'inicio'])"
      }
    }
  }
}
