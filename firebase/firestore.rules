rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    
    function isChofer() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'chofer';
    }
    
    function isAlumno() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'alumno';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Usuarios - Solo el admin y el propio usuario pueden leer
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
    
    // Choferes - Admin gestiona, choferes leen su propia info
    match /choferes/{choferId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Alumnos - Admin y propio alumno pueden leer
    match /alumnos/{alumnoId} {
      allow read: if isAdmin() || isOwner(alumnoId);
      allow create: if isAlumno();
      allow update: if isAdmin() || isOwner(alumnoId);
      allow delete: if isAdmin();
    }
    
    // Rutas - Todos los autenticados pueden leer, solo admin modifica
    match /rutas/{rutaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Viajes - Choferes crean sus viajes, todos leen
    match /viajes/{viajeId} {
      allow read: if isAuthenticated();
      allow create: if isChofer();
      allow update: if isChofer() && 
                     resource.data.chofer_id == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // Ubicaciones de espera - Alumnos gestionan las suyas, choferes y admin leen
    match /ubicaciones_espera_alumnos/{ubicacionId} {
      allow read: if isAuthenticated();
      allow create: if isAlumno();
      allow update: if isAlumno() && 
                     resource.data.alumno_id == request.auth.uid;
      allow delete: if isAdmin() || 
                     (isAlumno() && resource.data.alumno_id == request.auth.uid);
    }
    
    // Notificaciones - Usuarios leen las suyas
    match /notificaciones/{notifId} {
      allow read: if isAuthenticated() && 
                   (resource.data.usuario_destinatario == request.auth.uid ||
                    resource.data.rol_destinatario == 
                    get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol);
      allow create: if isAdmin();
      allow update: if isAuthenticated() && 
                     resource.data.usuario_destinatario == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // Logs de auditoría - Solo admin lee
    match /logs_auditoria/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
